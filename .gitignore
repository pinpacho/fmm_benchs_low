# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
# (setup.sh's own venv lives outside this repo, at $HOME/.venvs/fmmbench,
#  so it is never a git concern; these patterns catch anyone who creates
#  one locally instead, e.g. on a fresh Linux-only machine)
.venv*/
venv/
env/
ENV/
.env

# Jupyter
.ipynb_checkpoints/
.jupyter/
.virtual_documents/

# Generated experiment artifacts (the executed notebook IS committed;
# figures/results are regenerated by running it)
figures/*
!figures/.gitkeep
results/*
!results/.gitkeep
data/
logs/

# MNN-H2 training byproducts
*.weights.h5

# OS noise
.DS_Store
Thumbs.db
desktop.ini
